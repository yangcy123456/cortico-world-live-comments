{
  "name": "cortico-world-live-comments",
  "version": "1.0.1",
  "type": "module",
  "description": "支持 B 站直播姬和抖音直播伴侣：读取直播评论、礼物与关注，由当前 Coo 人格回复；自带 Edge 语音朗读和可编辑弹幕记忆。",
  "main": "index.js",
  "exports": "./index.js",
  "keywords": [
    "cortico-world",
    "cortico",
    "live",
    "streaming",
    "danmaku",
    "bilibili",
    "douyin",
    "抖音",
    "tts",
    "ocr"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "lib/**",
    "dist/**",
    "vendor/**",
    "native/**",
    "assets/**",
    "ENV_PROMPT.md",
    "describe.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yangcy123456 <2176975366@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangcy123456/cortico-world-live-comments.git"
  },
  "homepage": "https://github.com/yangcy123456/cortico-world-live-comments#readme",
  "bugs": {
    "url": "https://github.com/yangcy123456/cortico-world-live-comments/issues"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "直播互动助手",
    "icon": "assets/icon.svg",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json",
    "tags": [
      "streaming",
      "live",
      "danmaku",
      "tts"
    ],
    "locales": {
      "zh": {
        "displayName": "直播互动助手",
        "description": "支持 B 站直播姬与抖音直播伴侣；读弹幕、礼物和关注，用当前 Coo 人格回复并朗读，附带可删改的弹幕记忆。"
      },
      "en": {
        "displayName": "Live Comments",
        "description": "Supports Bilibili Live Studio and Douyin Live Companion. Reads comments, gifts, and follows, replies with the current Coo persona, speaks replies with its own Edge TTS engine, and keeps an editable comment memory."
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --experimental-transform-types scripts/check.mjs"
  },
  "dependencies": {
    "mpg123-decoder": "^1.0.3",
    "ws": "^8.22.0"
  }
}
